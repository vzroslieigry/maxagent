{
  "manifest_version": 3,
  "name": "maxagent bridge",
  "version": "0.6.0",
  "description": "Lets your AI agents use this browser through maxagent-bridge: you approve each agent, see every action, and can stop it at any time.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "maxagent bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Allow tab audio here (open maxagent bridge)"
    }
  }
}
